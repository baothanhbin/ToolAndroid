<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLanguage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/containerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="-8dp"
        android:background="@drawable/bg_item_language_off"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/iv_language"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:layout_constraintTop_toBottomOf="@id/containerView"/>

    <ImageView
        android:id="@+id/iv_language"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_language_en"
        app:layout_constraintTop_toTopOf="@id/containerView"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/tv_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/iv_language"
        app:layout_constraintBottom_toBottomOf="@id/iv_language"
        android:text="English"
        android:textSize="16sp"
        android:fontFamily="@font/inter_regular"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/iv_language"/>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animationView"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        app:lottie_rawRes="@raw/hand_language"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>