<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLanguage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/containerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="-16dp"
        android:background="@drawable/bg_item_language_off"
        app:layout_constraintBottom_toBottomOf="@id/iv_language"
        app:layout_constraintTop_toBottomOf="@id/paddingTop" />

    <View
        android:id="@+id/touchView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:foreground="@drawable/ripple_12"
        android:elevation="100dp"
        app:layout_constraintTop_toTopOf="@id/containerView"
        app:layout_constraintBottom_toBottomOf="@id/containerView"/>

    <View
        android:id="@+id/paddingTop"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/iv_language"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_language_en"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/containerView" />

    <TextView
        android:id="@+id/tv_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/inter_regular"
        android:textColor="@color/lang_unselect_color"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/regionName"
        app:layout_constraintStart_toEndOf="@id/iv_language"
        app:layout_constraintTop_toTopOf="@id/iv_language"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/regionName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/inter_regular"
        android:textColor="@color/region_unselect_color"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_language"
        app:layout_constraintStart_toStartOf="@id/tv_language"
        app:layout_constraintTop_toBottomOf="@id/tv_language" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="tv_language, regionName" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFlag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:nestedScrollingEnabled="false"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="@id/containerView"
        app:layout_constraintEnd_toStartOf="@id/icArrow"
        app:layout_constraintStart_toEndOf="@id/barrierName"
        app:layout_constraintTop_toTopOf="@id/containerView"
        app:stackFromEnd="true" />

    <ImageView
        android:id="@+id/icArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_arrow_down"
        app:layout_constraintBottom_toBottomOf="@id/containerView"
        app:layout_constraintEnd_toEndOf="@id/containerView"
        app:layout_constraintTop_toTopOf="@id/containerView"
        app:tint="@color/region_unselect_color" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animationView"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/hand_language" />


</androidx.constraintlayout.widget.ConstraintLayout>