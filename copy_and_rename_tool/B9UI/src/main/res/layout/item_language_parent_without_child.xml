<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLanguage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/containerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="-16dp"
        android:background="@drawable/bg_item_language_off"
        android:foreground="@drawable/ripple_12"
        app:layout_constraintBottom_toBottomOf="@id/iv_language"
        app:layout_constraintTop_toBottomOf="@id/paddingTop" />

    <View
        android:id="@+id/paddingTop"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintTop_toBottomOf="@id/iv_language"/>

    <ImageView
        android:id="@+id/iv_language"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_language_en"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/containerView" />

    <TextView
        android:id="@+id/tv_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/inter_regular"
        android:text="English"
        android:textColor="#333333"
        android:textSize="16sp"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintBottom_toTopOf="@id/regionName"
        app:layout_constraintStart_toEndOf="@id/iv_language"
        app:layout_constraintTop_toTopOf="@id/iv_language" />

    <TextView
        android:id="@+id/regionName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_regular"
        android:text="English"
        android:textColor="#B2B2B2"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="@id/tv_language"
        app:layout_constraintTop_toBottomOf="@id/tv_language"
        app:layout_constraintBottom_toBottomOf="@id/iv_language"/>

    <ImageView
        android:id="@+id/icSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_lang_unselect"
        app:layout_constraintTop_toTopOf="@id/containerView"
        app:layout_constraintBottom_toBottomOf="@id/containerView"
        app:layout_constraintEnd_toEndOf="@id/containerView"/>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animationView"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/hand_language" />
</androidx.constraintlayout.widget.ConstraintLayout>
