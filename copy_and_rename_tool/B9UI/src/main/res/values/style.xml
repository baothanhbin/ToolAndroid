<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Native">
    </style>
    <style name="Native.AdButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">12dp</item>
        <item name="android:layout_marginRight">12dp</item>
        <item name="android:background">@drawable/native_custom_button</item>
        <item name="android:radius">10dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Native.AdHeadline">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Native.AdBody">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">13sp</item>
        <item name="android:alpha">0.5</item>

    </style>

    <style name="Native.AdIcon">
        <item name="android:textSize">8.0sp</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/ads_bg_icon</item>
        <item name="android:backgroundTint">#5EB4FF</item>
        <item name="android:paddingLeft">6dip</item>
        <item name="android:paddingRight">6dip</item>
        <item name="android:paddingBottom">3dip</item>
        <item name="android:paddingTop">3dip</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">15px</item>
        <item name="android:minHeight">15px</item>
        <item name="android:text">Ad</item>
    </style>


    <!-- Base application theme. -->
    <style name="Base.Theme.GeminiApp" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize Bottom Navigation View color -->
<!--        HINH fix status header bar-->
<!--        <item name="colorPrimary">@color/primaryColor</item>-->
<!--        <item name="colorPrimaryVariant">@color/primaryDarkColor</item>-->
<!--        <item name="android:statusBarColor">@color/primaryColor</item>-->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Customize your light theme here. -->
    </style>

    <!-- Theme for the Bottom Navigation View -->
    <style name="Theme.BottomNavigation" parent="Base.Theme.GeminiApp" />

    <!-- Custom style for the active indicator in Bottom Navigation View -->
    <style name="App.Custom.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- Style for text appearance in Bottom Navigation View -->
    <style name="BottomNavigationViewTextStyle">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="BaseDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>


<!--    VIET ANH-->
<!--    fix display logo in splash-->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_splash</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.GeminiApp</item>
    </style>
    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>
    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!--CustomText-->
    <style name="CustomText_Black_12">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="fontFamily">@font/urbanist_semibold</item>
    </style>

    <style name="CustomText_Black_13">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="fontFamily">@font/urbanist_semibold</item>
    </style>

    <style name="CustomText_Black_16">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="fontFamily">@font/urbanist_semibold</item>
    </style>

    <style name="CustomText_Black_20">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="fontFamily">@font/urbanist_semibold</item>
    </style>

</resources>
